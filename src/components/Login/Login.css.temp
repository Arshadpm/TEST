.login-container {
  min-height: 100vh;
  background-color: #fff;
  display: flex;
  overflow: hidden;
  width: 100%;
}

.login-form-section {
  display: flex;
  align-items: center;
  justify-content: flex-start;
  padding: 2rem 3rem;
  height: 100vh;
}

.login-form-wrapper {
  width: 100%;
  max-width: 400px;
  padding: 1rem;
  margin-left: 2rem;
}

.login-header {
  margin-bottom: 2rem;
  text-align: left;
  width: 280px;
  margin-left: 0;
  margin-right: auto;
}

.sign-in-title {
  font-family: 'Noto Sans', sans-serif;
  font-size: 32px;
  font-weight: 700;
  font-style: normal;
  line-height: 42px;
  letter-spacing: 0%;
  color: #333;
  margin-bottom: 0.25rem;
}

.new-user-text {
  font-family: 'Noto Sans', sans-serif;
  font-size: 16px;
  font-weight: 700;
  font-style: normal;
  line-height: 26px;
  letter-spacing: 0%;
  margin-bottom: 1.5rem;
}

.create-account-link {
  color: #2d7dfa;
  text-decoration: none;
  font-family: 'Noto Sans', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 26px;
  letter-spacing: 0%;
}

.login-image-section {
  height: 100vh;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fff;
  position: relative;
}

.login-image {
  width: auto;
  height: auto;
  max-height: 80vh;
  max-width: 100%;
  object-fit: contain;
  object-position: center;
  display: block;
  image-rendering: -webkit-optimize-contrast;
  image-rendering: crisp-edges;
}

.image-container {
  width: 100%;
  height: 100%;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Form styling */
.form-group {
  margin-bottom: 1rem;
  display: flex;
  justify-content: flex-start;
}

.form-input {
  width: 280px;
  padding: 0.75rem 1rem;
  border: 2px solid #3E3E3E;
  border-radius: 3px;
  font-family: 'Noto Sans', sans-serif;
  font-size: 16px;
  font-weight: 600;
  font-style: normal;
  line-height: 100%;
  letter-spacing: 0%;
  color: #333;
  box-sizing: border-box;
  height: 48px;
  opacity: 1;
}

.form-input::placeholder {
  font-family: 'Noto Sans', sans-serif;
  font-size: 16px;
  font-weight: 600;
  font-style: normal;
  line-height: 100%;
  letter-spacing: 0%;
  color: #888;
}

.form-input:focus {
  outline: none;
  border-color: #000;
}

.form-check {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-bottom: 1rem;
  width: 280px;
  margin-left: 0;
  margin-right: auto;
}

.form-check-input {
  width: 16px;
  height: 16px;
  margin: 0;
  cursor: pointer;
  border: 2px solid #000000;
  border-radius: 2px;
  appearance: none;
  -webkit-appearance: none;
  -moz-appearance: none;
  background-color: transparent;
  position: relative;
}

.form-check-input:checked {
  background-color: #000000;
}

.form-check-input:checked::after {
  content: "✓";
  position: absolute;
  font-size: 12px;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  color: white;
}

.form-check-label {
  font-family: 'Noto Sans', sans-serif;
  font-size: 16px;
  font-weight: 700;
  line-height: 26px;
  letter-spacing: 0%;
  color: #333;
  cursor: pointer;
  margin: 0;
  user-select: none;
}

.submit-button {
  width: 280px;
  padding: 0.75rem;
  border: none;
  border-radius: 3px;
  background-color: #444;
  color: white;
  font-family: 'Noto Sans', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 26px;
  letter-spacing: 0%;
  cursor: pointer;
  margin-bottom: 1.5rem;
  height: 48px;
  margin-left: 0;
  margin-right: auto;
  display: block;
}

.submit-button:hover {
  background-color: #333;
}

.divider {
  text-align: center;
  position: relative;
  margin: 1.5rem 0;
  width: 280px;
}

.divider::before,
.divider::after {
  content: "";
  position: absolute;
  top: 50%;
  width: calc(50% - 70px);
  height: 1px;
  background-color: #ced4da;
}

.divider::before {
  left: 0;
}

.divider::after {
  right: 0;
}

.divider span {
  background-color: #fff;
  padding: 0 0.75rem;
  color: #333;
  font-family: 'Noto Sans', sans-serif;
  font-weight: 700;
  font-size: 16px;
  line-height: 26px;
  letter-spacing: 0%;
}

.social-login {
  display: flex;
  justify-content: flex-start;
  gap: 0.75rem;
  width: 280px;
  margin-left: 0;
  margin-right: auto;
}

.social-button {
  width: 48px;
  height: 48px;
  border: 1px solid #ced4da;
  border-radius: 50%;
  background-color: transparent;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 8px;
}

.social-icon {
  color: #333;
  font-size: 16px;
  font-weight: 500;
}

.social-button:hover {
  border-color: #2d7dfa;
  color: #2d7dfa;
}

/* Mobile responsiveness */
@media (max-width: 767px) {
  .login-form-section {
    padding: 1rem;
  }

  .login-form-wrapper {
    padding: 0;
  }
}